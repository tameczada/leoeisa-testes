<%- include('partials/head') %>
<%- include('partials/header') %>

<% if (error) { %>
<div class="alert-banner">
  <% if (error === 'auth') { %> Você precisa estar logado para votar.
  <% } else if (error === 'twitch_denied') { %> Login cancelado.
  <% } else if (error === 'oauth_failed') { %> Erro ao conectar com a Twitch. Tente novamente.
  <% } else { %> Ocorreu um erro. Tente novamente.
  <% } %>
  <button onclick="this.parentElement.remove()" class="alert-close">✕</button>
</div>
<% } %>

<section class="hero">
  <h1>VOTE NO SEU<br><em>FILME FAVORITO</em></h1>
  <p>Conecte sua conta Twitch e vote nos filmes que você quer ver na live.</p>
  <div class="live-count">
    <span class="live-dot"></span>
    <span id="totalVotesDisplay"><%= total.toLocaleString('pt-BR') %> votos registrados</span>
  </div>
</section>

<div class="filters">
  <span class="filter-label">Categoria</span>
  <%
    const catLabels = {
      todos: 'Todos',
      acao: '⚔️ Ação',
      comedia: '😂 Comédia',
      terror: '👻 Terror',
      drama: '🎭 Drama',
      ficcao: '🚀 Ficção Científica',
      animacao: '🎨 Animação'
    };
  %>
  <% categories.forEach(cat => { %>
    <a href="/?category=<%= cat %>" class="chip <%= activeCategory === cat ? 'active' : '' %>">
      <%= catLabels[cat] || cat %>
    </a>
  <% }) %>
</div>

<div class="search-bar">
  <div class="search-wrap">
    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" width="15" height="15"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    <input class="search-input" id="movieSearch" placeholder="Buscar filme..." autocomplete="off">
  </div>
</div>
<p id="noResults" style="display:none;text-align:center;color:var(--muted);padding:2rem 0;font-size:.9rem;">Nenhum filme encontrado.</p>

<div class="view-toggle">
  <button class="view-toggle-btn active" id="btnGridView" title="Grade" aria-label="Grade">
    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
  </button>
  <button class="view-toggle-btn" id="btnListView" title="Lista" aria-label="Lista">
    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
  </button>
  <button class="view-toggle-btn" id="btnCompactView" title="Compacto" aria-label="Compacto">
    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
  </button>
  <button class="view-toggle-btn" id="btnRankingView" title="Ranking" aria-label="Ranking">
    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
  </button>
</div>

<div class="grid" id="movieGrid">
  <% if (movies.length === 0) { %>
    <div class="empty">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.069A1 1 0 0121 8.87v6.26a1 1 0 01-1.447.894L15 14M3 8a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z"/></svg>
      <p>Nenhum filme nessa categoria meu Relíkia.</p>
    </div>
  <% } %>

  <% movies.forEach((movie, i) => { %>
    <%
      const catLabel = catLabels[movie.category] || movie.category;
    %>
    <div class="card" style="animation-delay:<%= i * 0.05 %>s" data-title="<%= movie.title.toLowerCase() %>">
      <div class="card-poster">
        <img
          src="<%= movie.poster || 'https://placehold.co/500x281/1c1e27/6b7080?text=Sem+Poster' %>"
          alt="<%= movie.title %>"
          loading="lazy"
          onerror="this.src='https://placehold.co/500x281/1c1e27/6b7080?text=Sem+Poster'"
        >
        <span class="card-rank">#<%= movie.rank %></span>
        <span class="card-badge"><%= catLabel %></span>
      </div>
      <div class="card-body">
        <div class="card-title"><%= movie.title %></div>
                <div class="card-description"><%= movie.description %></div>
        <div class="card-meta"><%= movie.year %></div>
        <div class="progress-wrap">
          <div class="progress-info">
            <span class="vote-count"><%= movie.voteCount.toLocaleString('pt-BR') %> votos</span>
            <span class="vote-pct"><%= movie.pct %>%</span>
          </div>
          <div class="progress-bar">
            <div class="progress-fill <%= movie.rankClass %>" style="width:<%= movie.barW %>%"></div>
          </div>
        </div>

        <% if (!user) { %>
          <a href="/auth/twitch" class="btn-vote">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
            Votar
          </a>
        <% } else if (movie.hasVoted) { %>
          <button class="btn-vote voted" disabled>
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Votado!
          </button>
        <% } else { %>
          <button
            class="btn-vote"
            data-movie-id="<%= movie.id %>"
            data-movie-title="<%= movie.title %>"
          >
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
            Votar
          </button>
        <% } %>

        <% if (reactionsEnabled) { %>
        <div class="reactions-wrap" data-movie-id="<%= movie.id %>">
          <!-- Reações com contagem (só aparecem se count > 0) -->
          <div class="reactions-display"></div>
          <!-- Botão reagir -->
          <button class="btn-react" data-movie-id="<%= movie.id %>">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" width="13" height="13"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Reagir
          </button>
          <!-- Picker (oculto por padrão) -->
          <div class="reaction-picker" style="display:none;">
            <% ["🔥", "❤️", "😂", "😮", "👏", "💀","💕","🙏","👀","🤓","😠","💩","🥱","💯","👌","👍"].forEach(function(emoji) { %>
              <button class="reaction-pick-btn" data-emoji="<%= emoji %>" data-movie-id="<%= movie.id %>"><%= emoji %></button>
            <% }); %>
          </div>
        </div>
        <% } %>

      </div>
    </div>
  <% }) %>
</div>

<!-- Toast -->
<div class="toast" id="toast">
  <span class="toast-dot" id="toastDot"></span>
  <span id="toastMsg"></span>
</div>

<!-- Modal Regras -->
<div class="modal-overlay" id="rulesModal">
  <div class="rules-modal">
    <div class="rules-header">
      <div>
        <span class="rules-tag">REGULAMENTO</span>
        <h2>Regras da Votação</h2>
      </div>
      <button class="rules-close" id="btnCloseRules">Fechar</button>
    </div>
    <div class="rules-body">

      <div class="rules-chapter">
        <div class="rules-chapter-title">CAPÍTULO I — INDICAÇÕES DOS FILMES(leia com atêncão)</div>
        <div class="rules-article-title">Art. 1º - Das Indicações para Votação</div>
        <ol>
          <li>I - A indicação de filmes com duração de até 2h30min para votação no site deverá ser realizada mediante contribuição mínima de R$ 6,00;</li>
          <li>II - A indicação de filmes com duração superior a 2h30min deverá ser realizada mediante contribuição mínima de R$ 12,00;</li>
          <li>III - As enquetes realizadas na Twitch conterão sempre os 3 filmes mais votados dentro do gênero especificado pelo streamer.</li>
        </ol>
      </div>

      <div class="rules-chapter">
        <div class="rules-chapter-title">CAPÍTULO I — INDICAÇÕES DOS FILMES</div>
        <div class="rules-article-title">Art. 2º - Da Revotação</div>
        <ol>
          <li>I - A revotação poderá ser adquirida mediante contribuição de R$ 150,00, garantindo ao comprador o direito de adicionar diretamente um filme à enquete, independentemente da votação do site;</li>
          <li>II - Caso o filme indicado por revotação não seja vencedor da enquete, este será automaticamente direcionado para a lista oficial de votação do site.</li>
        </ol>
      </div>

      <div class="rules-chapter">
        <div class="rules-chapter-title">CAPÍTULO I — INDICAÇÕES DOS FILMES</div>
        <div class="rules-article-title">Art. 3º - Do Empate na Enquete</div>
        <p>Em caso de empate nas enquetes da Twitch, será instaurada uma Roleta Beneficente de Desempate, na qual:</p>
        <ol>
          <li>I - Cada ticket custará R$ 2,00;</li>
          <li>II - O filme vencedor será definido conforme o resultado da roleta.</li>
        </ol>
      </div>

      <div class="rules-chapter">
        <div class="rules-chapter-title">CAPÍTULO I — INDICAÇÕES DOS FILMES</div>
        <div class="rules-article-title">Art. 4º - Da Renovação das Indicações</div>
        <ol>
          <li>I - Nos dias 15 e 30 de cada mês, todas as indicações presentes no site serão zeradas;</li>
          <li>II – O objetivo da renovação será permitir novas disputas e oportunidades para diferentes filmes;</li>
          <li>III – Filmes anteriormente indicados poderão retornar à votação, porém reiniciarão com 0 votos.
          </li>
        </ol>
      </div>
      
      <div class="rules-chapter">
        <div class="rules-chapter-title">CAPÍTULO II — PROIBICÕES E LIMITACÕES</div>
        <div class="rules-article-title">Art. 5º - Dos Filmes Abaixo dos Anos 2000</div>
        <p>Filmes lançados antes do ano 2000 somente serão elegíveis para enquete caso:</p>
        <ol>
          <li>I - Possuam mais de 200 votos no site;</li>
          <li>II - Estejam posicionados dentro do Top 3 da votação.
          </li>
        </ol>
      </div>
      
      <div class="rules-chapter">
        <div class="rules-chapter-title">CAPÍTULO II — PROIBICÕES E LIMITAÇÕES</div>
        <div class="rules-article-title">Art. 6º - Dos Musicais
          Filmes do gênero musical somente estão proibidos
         </div>
        <div class="rules-article-title">Art. 7º - Dos Filmes de Otaku
           Filmes considerados “de otaku” somente serão elegíveis para enquete caso:
        </div>
        <ol>
          <li>
            I – Possuam mais de 200 votos;
          </li>
          <li>
            II – Recebam aprovação expressa dos streamers.
          </li>
        </ol>
        <div>
            Art. 8º – Das Obras Proibidas
Fica terminantemente proibida a indicação de:
          </div>
          <ol>
            <li>
              I - Series
            </li>
            <li>
              II - Animes Seriados
            </li>
          </ol>
      </div>
      
      <div class="rules-chapter">
        <div class="rules-chapter-title">CAPÍTULO II — PROIBIÇÕES E LIMiTAÇÕES</div>
        <div class="rules-article-title">Art. 9º – Das Sequências
          As sequências de filmes não poderão ser assistidas no mesmo dia da obra anterior, salvo exceções determinadas pelos streamers.</div>
      </div>
      
      
      <div class="rules-chapter">
        <div class="rules-chapter-title">CAPÍTULO III — DISPOSICOES FINAIS</div>
        <div class="rules-article-title">Art. 10º – Da Autoridade Suprema dos Streamers
          Os streamers poderão alterar, suspender, ignorar ou reinterpretar quaisquer regras previstas neste regulamento sempre que julgarem necessário.</div>
      </div>

    </div>
  </div>
</div>

<script src="/js/main.js"></script>
<script>
  // ── Reactions ──
  var reactionsEnabled = <%= reactionsEnabled %>;

  var EMOJIS        = ["🔥", "❤️", "😂", "😮", "👏", "💀","💕","🙏","👀","🤓","😠","💩","🥱","💯","👌","👍"];
  var customEmotes  = []; // { id, name, imageUrl }

  // Carrega emotes customizados e adiciona no picker
  async function loadCustomEmotes() {
    if (!reactionsEnabled) return;
    try {
      var res  = await fetch('/api/reactions/emotes');
      var fetched = await res.json();
      if (Array.isArray(fetched)) customEmotes = fetched;
      // Atualiza todos os pickers com os emotes customizados
      document.querySelectorAll('.reaction-picker').forEach(function(picker) {
        picker.querySelectorAll('.reaction-pick-btn[data-custom]').forEach(function(b) { b.remove(); });
        customEmotes.forEach(function(e) {
          var btn = document.createElement('button');
          btn.className = 'reaction-pick-btn';
          btn.setAttribute('data-emoji', e.name);
          btn.setAttribute('data-movie-id', picker.closest('.reactions-wrap').getAttribute('data-movie-id'));
          btn.setAttribute('data-custom', '1');
          btn.innerHTML = '<img src="' + e.imageUrl + '" style="width:20px;height:20px;object-fit:contain;" alt="' + e.name + '">';
          picker.appendChild(btn);
        });
      });
    } catch(err) { console.error('loadCustomEmotes:', err); }
  }

  function renderDisplay(wrap, counts, userReactions) {
    var display = wrap.querySelector('.reactions-display');
    display.innerHTML = '';

    // Emojis padrão
    EMOJIS.forEach(function(emoji) {
      var count = counts[emoji] || 0;
      if (count === 0) return;
      var btn = document.createElement('button');
      btn.className = 'reaction-btn' + (userReactions.includes(emoji) ? ' reacted' : '');
      btn.setAttribute('data-emoji', emoji);
      btn.setAttribute('data-movie-id', wrap.getAttribute('data-movie-id'));
      btn.innerHTML = '<span class="reaction-emoji">' + emoji + '</span><span class="reaction-count">' + count + '</span>';
      display.appendChild(btn);
    });

    // Emotes customizados
    customEmotes.forEach(function(e) {
      var count = counts[e.name] || 0;
      if (count === 0) return;
      var btn = document.createElement('button');
      btn.className = 'reaction-btn' + (userReactions.includes(e.name) ? ' reacted' : '');
      btn.setAttribute('data-emoji', e.name);
      btn.setAttribute('data-movie-id', wrap.getAttribute('data-movie-id'));
      btn.innerHTML = '<img src="' + e.imageUrl + '" style="width:18px;height:18px;object-fit:contain;" alt="' + e.name + '"><span class="reaction-count">' + count + '</span>';
      display.appendChild(btn);
    });
  }

  function loadReactions() {
    if (!reactionsEnabled) return;
    fetch('/api/reactions')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!data.enabled) return;
        document.querySelectorAll('.reactions-wrap[data-movie-id]').forEach(function(wrap) {
          var movieId = wrap.getAttribute('data-movie-id');
          var counts  = data.counts[movieId] || {};
          var mine    = data.userReactions[movieId] || [];
          renderDisplay(wrap, counts, mine);
        });
      });
  }

  // Fechar pickers abertos ao clicar fora
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.reactions-wrap')) {
      document.querySelectorAll('.reaction-picker').forEach(function(p) { p.style.display = 'none'; });
    }
  });

  document.addEventListener('click', function(e) {
    if (!reactionsEnabled) return;

    // Abrir/fechar picker
    var reactBtn = e.target.closest('.btn-react');
    if (reactBtn) {
      e.stopPropagation();
      var wrap   = reactBtn.closest('.reactions-wrap');
      var picker = wrap.querySelector('.reaction-picker');
      var isOpen = picker.style.display !== 'none';
      document.querySelectorAll('.reaction-picker').forEach(function(p) { p.style.display = 'none'; });
      picker.style.display = isOpen ? 'none' : 'flex';
      return;
    }

    // Clicar num emoji do picker
    var pickBtn = e.target.closest('.reaction-pick-btn');
    if (pickBtn) {
      e.stopPropagation();
      <% if (!user) { %>
        window.location.href = '/auth/twitch';
        return;
      <% } %>
      var emoji   = pickBtn.getAttribute('data-emoji');
      var movieId = pickBtn.getAttribute('data-movie-id');
      var wrap    = pickBtn.closest('.reactions-wrap');
      wrap.querySelector('.reaction-picker').style.display = 'none';

      fetch('/api/reactions/' + movieId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ emoji: emoji })
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        renderDisplay(wrap, data.counts || {}, Array.isArray(data.userReactions) ? data.userReactions : []);
      });
      return;
    }

    // Clicar numa reação já exibida (toggle off)
    var reactionBtn = e.target.closest('.reaction-btn');
    if (reactionBtn) {
      <% if (!user) { %>
        window.location.href = '/auth/twitch';
        return;
      <% } %>
      var emoji   = reactionBtn.getAttribute('data-emoji');
      var movieId = reactionBtn.getAttribute('data-movie-id');
      var wrap    = reactionBtn.closest('.reactions-wrap');

      fetch('/api/reactions/' + movieId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ emoji: emoji })
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        renderDisplay(wrap, data.counts || {}, Array.isArray(data.userReactions) ? data.userReactions : []);
      });
    }
  });

  // Carrega emotes primeiro, depois reações (garante que customEmotes está populado)
  loadCustomEmotes().then(function() { loadReactions(); });

  // ── View toggle ──
  const movieGrid    = document.getElementById('movieGrid');
  const btnGrid      = document.getElementById('btnGridView');
  const btnList      = document.getElementById('btnListView');
  const btnCompact   = document.getElementById('btnCompactView');
  const btnRanking   = document.getElementById('btnRankingView');

  const VIEW_CLASSES = ['list-view', 'compact-view', 'ranking-view'];
  const VIEW_BTNS    = { grid: btnGrid, list: btnList, compact: btnCompact, ranking: btnRanking };

  function setView(mode) {
    VIEW_CLASSES.forEach(c => movieGrid.classList.remove(c));
    Object.values(VIEW_BTNS).forEach(b => b && b.classList.remove('active'));
    if (mode === 'list')    movieGrid.classList.add('list-view');
    if (mode === 'compact') movieGrid.classList.add('compact-view');
    if (mode === 'ranking') movieGrid.classList.add('ranking-view');
    if (VIEW_BTNS[mode]) VIEW_BTNS[mode].classList.add('active');
    try { localStorage.setItem('cv_view', mode); } catch(e) {}
  }

  try {
    const saved = localStorage.getItem('cv_view');
    if (['list','compact','ranking'].includes(saved)) setView(saved);
  } catch(e) {}

  if (btnGrid)    btnGrid.addEventListener('click',    () => setView('grid'));
  if (btnList)    btnList.addEventListener('click',    () => setView('list'));
  if (btnCompact) btnCompact.addEventListener('click', () => setView('compact'));
  if (btnRanking) btnRanking.addEventListener('click', () => setView('ranking'));

  // ── Search ──
  const movieSearch = document.getElementById('movieSearch');
  const noResults   = document.getElementById('noResults');

  if (movieSearch) {
    movieSearch.addEventListener('input', function() {
      const q = this.value.toLowerCase().trim();
      const cards = document.querySelectorAll('#movieGrid .card');
      let visible = 0;

      cards.forEach(function(card) {
        const title = card.getAttribute('data-title') || '';
        const show  = !q || title.includes(q);
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      noResults.style.display = visible === 0 && q ? 'block' : 'none';
    });
  }
</script>
</body>
</html>
